config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Shotgun Kid"
run/main_scene="res://scenes/levels/training_yard.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

